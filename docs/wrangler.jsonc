{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The built files from ./dist, behind a small Worker (worker/index.ts) that runs first: Markdown on request, the API
	// catalog, Link headers, and IndexNow from the daily cron.
	"name": "mcpapi-docs",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-20",
	"routes": [{ "pattern": "docs.mcpapi.one", "custom_domain": true }],
	"workers_dev": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	// toMarkdown only: converting HTML is free, no model runs.
	"ai": { "binding": "AI" },
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"triggers": { "crons": ["23 4 * * *"] },
	"observability": {
		"enabled": true
	}
}
